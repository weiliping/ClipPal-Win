<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- WPF 必须在 manifest 里声明 PerMonitorV2；WinForms 分析器（只需托盘图标）会误报 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <RootNamespace>ClipPal</RootNamespace>
    <AssemblyName>ClipPal</AssemblyName>

    <!-- 资源与版本信息 -->
    <ApplicationIcon>Assets\clippal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>ClipPal / 剪贴伴侣</Product>
    <AssemblyTitle>ClipPal</AssemblyTitle>
    <Company>ClipPal</Company>
    <Description>Menu bar clipboard history / 剪贴板历史</Description>
  </PropertyGroup>

</Project>
