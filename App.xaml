<Application x:Class="ClipPal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 实际颜色在启动时由 ThemeManager 按浅色/深色覆盖 -->
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D8D8D8"/>
        <SolidColorBrush x:Key="PanelTextBrush" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="PanelSubtleBrush" Color="#6B6B6B"/>
        <SolidColorBrush x:Key="RowSelectedBrush" Color="#0A6CFF"/>
        <SolidColorBrush x:Key="RowSelectedTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#EDEDED"/>
    </Application.Resources>
</Application>
