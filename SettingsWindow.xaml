<Window x:Class="ClipPal.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipPal"
        Width="460" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PanelTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- 历史记录条数 -->
            <TextBlock x:Name="LimitHeader" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Limit30" Content="30" GroupName="Limit" Margin="0,0,12,0"/>
                <RadioButton x:Name="Limit50" Content="50" GroupName="Limit" Margin="0,0,12,0"/>
                <RadioButton x:Name="Limit100" Content="100" GroupName="Limit" Margin="0,0,12,0"/>
                <RadioButton x:Name="LimitCustom" GroupName="Limit" Margin="0,0,12,0"/>
                <TextBox x:Name="CustomLimitBox" Width="64" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="LimitHint" FontSize="11" Opacity="0.7" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <!-- 全局快捷键 -->
            <TextBlock x:Name="HotKeyHeader" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="RecorderBox" Width="180" Height="34" CornerRadius="6"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand"
                        MouseLeftButtonDown="RecorderBox_MouseLeftButtonDown"
                        PreviewKeyDown="RecorderBox_PreviewKeyDown"
                        LostFocus="RecorderBox_LostFocus">
                    <TextBlock x:Name="RecorderText" VerticalAlignment="Center"
                               HorizontalAlignment="Center" FontSize="13"/>
                </Border>
                <Button x:Name="ResetHotKeyBtn" Margin="10,0,0,0" Padding="10,4" Click="ResetHotKeyBtn_Click"/>
            </StackPanel>
            <TextBlock x:Name="HotKeyHint" FontSize="11" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="HotKeyErrorText" FontSize="11" Foreground="#D9534F"
                       Margin="0,2,0,18" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- 行为 -->
            <TextBlock x:Name="BehaviorHeader" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <CheckBox x:Name="PasteAuto" Margin="0,0,0,6"/>
            <CheckBox x:Name="PlaySound" Margin="0,0,0,6"/>
            <CheckBox x:Name="IgnoreConcealed" Margin="0,0,0,6"/>
            <CheckBox x:Name="LaunchAtLogin" Margin="0,0,0,6"/>
            <CheckBox x:Name="ConfirmClear" Margin="0,0,0,6"/>
            <TextBlock x:Name="ElevationHint" FontSize="11" Opacity="0.7"
                       Margin="0,0,0,18" TextWrapping="Wrap"/>

            <!-- 外观 -->
            <TextBlock x:Name="AppearanceHeader" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="LanguageBox" Width="220" SelectionChanged="LanguageBox_SelectionChanged"/>
            </StackPanel>
            <TextBlock x:Name="OpacityLabel" Margin="0,0,0,2"/>
            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" SmallChange="0.02"
                    LargeChange="0.1" ValueChanged="OpacitySlider_ValueChanged" Margin="0,0,0,18"/>

            <!-- 数据 -->
            <TextBlock x:Name="DataHeader" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ShowFolderBtn" Padding="10,4" Margin="0,0,8,0" Click="ShowFolderBtn_Click"/>
                <Button x:Name="ClearUnpinnedBtn" Padding="10,4" Margin="0,0,8,0" Click="ClearUnpinnedBtn_Click"/>
                <Button x:Name="ClearAllBtn" Padding="10,4" Click="ClearAllBtn_Click"/>
            </StackPanel>
            <TextBlock x:Name="StoragePathText" FontSize="11" Opacity="0.7"
                       Margin="0,6,0,18" TextWrapping="Wrap"/>

            <Button x:Name="CloseBtn" Padding="16,6" HorizontalAlignment="Right"
                    Margin="0,6,0,0" Click="CloseBtn_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
